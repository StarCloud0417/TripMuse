# TripMuse API 環境變數配置
# 複製此文件為 .env 並填入你的 API Key

# Gemini API Key (從 Google AI Studio 獲取)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Places API Key (如果使用)
GOOGLE_PLACES_API_KEY=your_places_api_key_here

# Firebase 配置 (如果使用)
FIREBASE_PROJECT_ID=tripmuse-app

# 應用配置
NODE_ENV=production
PORT=8080
